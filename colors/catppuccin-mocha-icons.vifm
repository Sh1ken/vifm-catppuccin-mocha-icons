" Catppuccin Mocha for vifm, with Nerd Font file icons.
" https://github.com/Sh1ken/vifm-catppuccin-mocha-icons
"
" gui* colors apply when $TERM is a direct-color terminfo (e.g. xterm-direct);
" cterm* values are the nearest 256-color fallbacks.  Bars use the terminal
" background, so there are no grey bars and terminal transparency shows.
"
" Palette: Catppuccin (MIT), https://catppuccin.com
" Icons: yazi 26.9.1's built-in theme (MIT), https://yazi-rs.github.io

highlight clear
highlight Win          cterm=none      ctermfg=189     ctermbg=default gui=none      guifg=#cdd6f4 guibg=default
highlight OtherWin     cterm=none      ctermfg=189     ctermbg=default gui=none      guifg=#cdd6f4 guibg=default
highlight AuxWin       cterm=none      ctermfg=189     ctermbg=default gui=none      guifg=#cdd6f4 guibg=default
highlight OddLine      cterm=none      ctermfg=default ctermbg=default gui=none      guifg=default guibg=default
highlight TopLine      cterm=none      ctermfg=103     ctermbg=default gui=none      guifg=#7f849c guibg=default
highlight TopLineSel   cterm=bold      ctermfg=111     ctermbg=default gui=bold      guifg=#89b4fa guibg=default
highlight TabLine      cterm=none      ctermfg=103     ctermbg=default gui=none      guifg=#7f849c guibg=default
highlight TabLineSel   cterm=bold      ctermfg=183     ctermbg=default gui=bold      guifg=#cba6f7 guibg=default
highlight StatusLine   cterm=none      ctermfg=146     ctermbg=default gui=none      guifg=#a6adc8 guibg=default
highlight JobLine      cterm=none      ctermfg=146     ctermbg=default gui=none      guifg=#a6adc8 guibg=default
highlight CmdLine      cterm=none      ctermfg=189     ctermbg=default gui=none      guifg=#cdd6f4 guibg=default
highlight Border       cterm=none      ctermfg=239     ctermbg=default gui=none      guifg=#45475a guibg=default
highlight LineNr       cterm=none      ctermfg=243     ctermbg=default gui=none      guifg=#6c7086 guibg=default
highlight CurrLine     cterm=none      ctermfg=default ctermbg=237     gui=none      guifg=default guibg=#313244
highlight OtherLine    cterm=underline ctermfg=default ctermbg=default gui=underline guifg=default guibg=default
highlight Selected     cterm=bold      ctermfg=183     ctermbg=default gui=bold      guifg=#cba6f7 guibg=default
highlight ErrorMsg     cterm=bold      ctermfg=211     ctermbg=default gui=bold      guifg=#f38ba8 guibg=default
highlight WildBox      cterm=none      ctermfg=189     ctermbg=237     gui=none      guifg=#cdd6f4 guibg=#313244
highlight WildMenu     cterm=bold      ctermfg=233     ctermbg=111     gui=bold      guifg=#11111b guibg=#89b4fa
highlight SuggestBox   cterm=none      ctermfg=189     ctermbg=237     gui=none      guifg=#cdd6f4 guibg=#313244
highlight CmpMismatch  cterm=bold      ctermfg=211     ctermbg=default gui=bold      guifg=#f38ba8 guibg=default
highlight CmpUnmatched cterm=bold      ctermfg=151     ctermbg=default gui=bold      guifg=#a6e3a1 guibg=default
highlight CmpBlank     cterm=none      ctermfg=default ctermbg=default gui=none      guifg=default guibg=default
highlight Directory    cterm=bold      ctermfg=111     ctermbg=default gui=bold      guifg=#89b4fa guibg=default
highlight Executable   cterm=bold      ctermfg=151     ctermbg=default gui=bold      guifg=#a6e3a1 guibg=default
highlight Link         cterm=none      ctermfg=116     ctermbg=default gui=none      guifg=#94e2d5 guibg=default
highlight BrokenLink   cterm=none      ctermfg=211     ctermbg=default gui=none      guifg=#f38ba8 guibg=default
highlight HardLink     cterm=none      ctermfg=223     ctermbg=default gui=none      guifg=#f9e2af guibg=default
highlight Socket       cterm=none      ctermfg=218     ctermbg=default gui=none      guifg=#f5c2e7 guibg=default
highlight Device       cterm=none      ctermfg=216     ctermbg=default gui=none      guifg=#fab387 guibg=default
highlight Fifo         cterm=none      ctermfg=223     ctermbg=default gui=none      guifg=#f9e2af guibg=default
highlight {*.7z,*.bz2,*.dmg,*.gz,*.jar,*.rar,*.tar,*.tgz,*.xz,*.zip,*.zst}
        \ cterm=none ctermfg=216 ctermbg=default gui=none guifg=#fab387 guibg=default
highlight {*.bmp,*.gif,*.heic,*.ico,*.jpeg,*.jpg,*.png,*.svg,*.tif,*.tiff,*.webp}
        \ cterm=none ctermfg=116 ctermbg=default gui=none guifg=#89dceb guibg=default
highlight {*.aac,*.flac,*.m4a,*.mp3,*.ogg,*.opus,*.wav}
        \ cterm=none ctermfg=116 ctermbg=default gui=none guifg=#94e2d5 guibg=default
highlight {*.avi,*.m4v,*.mkv,*.mov,*.mp4,*.webm}
        \ cterm=none ctermfg=117 ctermbg=default gui=none guifg=#74c7ec guibg=default
highlight {*.doc,*.docx,*.epub,*.key,*.numbers,*.odt,*.pages,*.pdf,*.ppt,*.pptx,*.xls,*.xlsx}
        \ cterm=none ctermfg=218 ctermbg=default gui=none guifg=#f5c2e7 guibg=default
highlight {*.markdown,*.md,*.org,*.rst,*.txt,README,README.*,LICENSE*}
        \ cterm=none ctermfg=147 ctermbg=default gui=none guifg=#b4befe guibg=default

" Icons, as classify prefixes.  Order matters: exact names, then folder
" names, then extensions, then file types.
set classify=''
set classify+=' ::{.babelrc}::'
